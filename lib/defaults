# my functions
rebase_all() { local current=$(git branch --show-current); git fetch origin && git branch --format '%(refname:short)' | grep -v '^primary$' | while read -r b; do git checkout "$b" && git rebase origin/primary; done; git checkout "$current"; }
retag() {
  local tag="$1"

  if [[ -z "$tag" ]]; then
    echo "Usage: retag <tag-name>" >&2
    return 1
  fi

  git tag -d "$tag" 2>/dev/null
  git tag "$tag" HEAD && git push --force origin "$tag"
}

alias retag-stable='retag stable'
alias retag-dev='retag dev'
alias retag-major='retag major'
alias retag-fresh='retag fresh'
